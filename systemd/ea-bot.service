[Unit]
Description=ea-bot: Discord #assistant channel -> Claude Code sessions (Exec Assistant)
After=network-online.target

[Service]
WorkingDirectory=/home/tomas/systems/ea-bot
Environment=BOT_DIR=/home/tomas/systems/ea-bot
Environment=HOME=/home/tomas
ExecStart=/home/tomas/systems/dev-bot/venv/bin/python /home/tomas/systems/dev-bot/dev_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
