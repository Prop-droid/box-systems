[Unit]
Description=creative-bot: Discord #creative channel -> Claude Code sessions (Creative Lead)
After=network-online.target

[Service]
WorkingDirectory=/home/tomas/systems/creative-bot
Environment=BOT_DIR=/home/tomas/systems/creative-bot
Environment=HOME=/home/tomas
ExecStart=/home/tomas/systems/dev-bot/venv/bin/python /home/tomas/systems/dev-bot/dev_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
