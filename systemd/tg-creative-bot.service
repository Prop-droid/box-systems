[Unit]
Description=tg-creative-bot: Telegram forum group -> Claude Code sessions
After=network-online.target

[Service]
WorkingDirectory=%h/systems/dev-bot
Environment=BOT_DIR=%h/systems/tg-creative-bot
Environment=HOME=%h
ExecStart=%h/systems/dev-bot/venv/bin/python %h/systems/dev-bot/telegram_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
