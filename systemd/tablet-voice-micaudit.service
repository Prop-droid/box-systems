[Unit]
Description=tablet-voice mic audit: Android recording clients vs the lit state, WebView and Fully versions (adb only)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
ExecStartPre=-%h/systems/tablet-voice/fw-allow.sh
ExecStart=%h/systems/tablet-voice/mic_audit.sh
TimeoutStartSec=120
