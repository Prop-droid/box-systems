[Unit]
Description=memory-sweep: flush idle human Claude sessions that never fired SessionEnd

[Service]
Type=oneshot
WorkingDirectory=%h/.tools/claude-memory-compiler
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python hooks/session-end.py --sweep
Nice=10
TimeoutStartSec=20min
