[Unit]
Description=Shared adb server on :5037 (permanent home; oneshot adb clients like adb-tablet-connect/pixel-control otherwise spawn it in their cgroup and systemd kills it when they exit)
After=network-online.target

[Service]
# take over :5037 from any server a transient unit spawned; '-' = ignore "server not running"
ExecStartPre=-/usr/bin/adb kill-server
ExecStart=/usr/bin/adb -L tcp:5037 server nodaemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
