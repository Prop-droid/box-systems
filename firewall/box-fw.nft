#!/usr/sbin/nft -f
# tomas-agent-box LAN firewall (2026-09-03). Separate table at priority -10 so
# Tailscale's iptables-nft "ip filter" table is never touched. Tailnet has full
# access; the physical LAN (192.168.1.0/24, enp0s31f6) only gets the flows below.
# Reach everything else (CCC, NoMachine, md-server, calibre...) over Tailscale.
# Apply: sudo nft -f box-fw.nft   Rollback: sudo nft delete table inet fw
destroy table inet fw
table inet fw {
	chain input {
		type filter hook input priority -10; policy drop;
		iifname "lo" accept
		iifname "tailscale0" accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, icmpv6 } accept
		udp sport 67 udp dport 68 accept                     # DHCP renew
		udp dport 41641 accept                               # tailscale direct
		tcp dport 22 accept                                  # SSH (key-only)
		tcp dport 631 accept                                 # AirPrint/CUPS for Mac on LAN
		udp dport { 5353, 21027, 22000 } accept              # mDNS, syncthing discovery+quic
		tcp dport 22000 accept                               # syncthing
		ip saddr 192.168.1.89 tcp dport 8765 accept          # Lenovo tablet -> tablet-dash only
	}
}
